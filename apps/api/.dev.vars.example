# Real Neon connection string (e.g. a personal dev branch: `neon checkout <branch>`
# pulls this automatically into .env/.env.local — copy it here, or run tests with it
# exported directly). Tests that need a DB skip automatically when this isn't set.
DATABASE_URL=postgres://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require

GOOGLE_CLIENT_ID=replace-with-real-value
GOOGLE_CLIENT_SECRET=replace-with-real-value
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-hex-string
BETTER_AUTH_URL=http://localhost:8787
STUDIO_ORIGIN=http://localhost:5173

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=replace-with-real-value
B2_KEY_ID=replace-with-real-value
B2_APPLICATION_KEY=replace-with-real-value
