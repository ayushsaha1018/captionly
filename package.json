{
  "name": "captionly",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.4",
  "devDependencies": {
    "turbo": "^2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=studio",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=studio",
    "lint": "turbo run lint"
  }
}
